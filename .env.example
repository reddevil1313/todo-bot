# Required: get one from @BotFather on Telegram
BOT_TOKEN=

# Optional. Defaults to a local SQLite file (todo.db).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DEFAULT_TZ=Asia/Singapore

# Optional: set a public https URL to use webhooks instead of long polling
# WEBHOOK_URL=https://your-app.example.com
# PORT=8080

# Optional: enables LLM parsing for messages the rule-based parser cannot date
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5
